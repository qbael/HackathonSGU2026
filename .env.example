# Development only. Run python3 scripts/init_env.py to generate local secrets.
POSTGRES_DB=findie
POSTGRES_USER=findie
POSTGRES_PASSWORD=GENERATE_DATABASE_PASSWORD
POSTGRES_PORT=5432
POSTGRES_APP_USER=findie_app
POSTGRES_APP_PASSWORD=GENERATE_APP_DATABASE_PASSWORD
SEARCH_POSTGRES_DB=findie_search
SEARCH_POSTGRES_USER=findie_search_app
SEARCH_POSTGRES_PASSWORD=GENERATE_SEARCH_DATABASE_PASSWORD
AI_SERVICE_TOKEN=GENERATE_AI_SERVICE_TOKEN

# Load this file with: set -a; . ./.env; set +a
ConnectionStrings__Database="Host=127.0.0.1;Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_APP_USER};Password=${POSTGRES_APP_PASSWORD};Timeout=5"
# Google OAuth Web client; server only. Redirect URI for the Vite app:
# http://127.0.0.1:5173/api/auth/google/signin
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
# Whitelist email for Super Admin accounts (comma-separated):
ADMIN_EMAILS=
Ai__BaseUrl=http://127.0.0.1:8000
Ai__ServiceToken=${AI_SERVICE_TOKEN}
Ai__TimeoutSeconds=15

# Local RabbitMQ users; generated passwords are URL-safe hexadecimal strings.
RABBITMQ_ADMIN_USER=findie_admin
RABBITMQ_ADMIN_PASSWORD=GENERATE_RABBITMQ_ADMIN_PASSWORD
RABBITMQ_API_USER=findie_api
RABBITMQ_API_PASSWORD=GENERATE_RABBITMQ_API_PASSWORD
RABBITMQ_AI_USER=findie_ai
RABBITMQ_AI_PASSWORD=GENERATE_RABBITMQ_AI_PASSWORD
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Enable the .NET dispatcher only after the search worker is ready:
# RabbitMq__Uri=amqp://${RABBITMQ_API_USER}:${RABBITMQ_API_PASSWORD}@127.0.0.1:${RABBITMQ_PORT}/%2F
RabbitMq__Uri=
AI_RABBITMQ_URL=amqp://${RABBITMQ_AI_USER}:${RABBITMQ_AI_PASSWORD}@127.0.0.1:${RABBITMQ_PORT}/%2F
# Transient Python requests for public descriptions and approved processed images.
AI_MATERIALS_QUEUE=findie.api.materials
AI_MATERIALS_REPLY_QUEUE=findie.ai.materials.results
RabbitMq__MaterialsQueue=${AI_MATERIALS_QUEUE}
RabbitMq__MaterialsReplyQueue=${AI_MATERIALS_REPLY_QUEUE}

# make local-setup provisions these DSNs; model revisions come from the Colab notebook.
# See docs/guides/ai-service.md. No fake inference when a dependency is unavailable.
AI_SEARCH_DSN=
AI_SEARCH_MIGRATION_DSN=
# Optional Redis cache: keyword/location candidates (configured TTL) and scoped embeddings (300s).
# Leave AI_REDIS_URL empty to disable both caches.
REDIS_PORT=6379
AI_REDIS_URL=redis://127.0.0.1:${REDIS_PORT}/0
AI_SEARCH_CACHE_TTL_SECONDS=60
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
AI_EMBEDDING_MODEL=qwen3-embedding:4b
AI_EMBEDDING_REVISION=
AI_EMBEDDING_DIMENSIONS=2048
AI_TEXT_SEARCH_PROFILE=text-description-v1
# Semantic share in hybrid search (0..1); keyword share is 1 minus this value.
AI_SEARCH_SEMANTIC_WEIGHT=0.6
# OR thresholds for local-first expansion and similarity fallback filtering.
AI_SEARCH_MIN_IMAGE_SIMILARITY=0.6
AI_SEARCH_MIN_TEXT_SIMILARITY=0.6
AI_SEARCH_RELATIVE_SCORE_RATIO=0.75
# Optional pinned gateway reranker. Empty revision keeps similarity fallback active.
AI_RERANKER_MODEL=Qwen/Qwen3-VL-Reranker-2B
AI_RERANKER_REVISION=
AI_RERANK_MIN_IMAGE_SCORE=0.5
AI_RERANK_MIN_TEXT_SCORE=0.5
# Offline production evaluation uses a separate broker account with temporary reply-queue permissions.
AI_EVALUATION_RABBITMQ_URL=
Ai__EmbeddingModelId=${AI_EMBEDDING_MODEL}
Ai__EmbeddingRevision=${AI_EMBEDDING_REVISION}
Ai__EmbeddingDimensions=${AI_EMBEDDING_DIMENSIONS}
Ai__TextSearchProfile=${AI_TEXT_SEARCH_PROFILE}
AI_REDACTION_MODEL=qwen3-vl:4b-instruct
AI_REDACTION_REVISION=
AI_IMAGE_SEARCH_ENABLED=false
AI_IMAGE_SEARCH_PROFILE=image-only-v1
Ai__RedactionModelId=${AI_REDACTION_MODEL}
Ai__RedactionRevision=${AI_REDACTION_REVISION}
Ai__RedactionProfile=redact-v4
Ai__ImageSearchProfile=${AI_IMAGE_SEARCH_PROFILE}

# R2 is private and stores processed output only; credentials stay in the backend.
Storage__Endpoint=
Storage__Bucket=
Storage__AccessKeyId=
Storage__SecretAccessKey=
